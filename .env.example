# Database Configuration
POSTGRES_DB=nomoodoc
POSTGRES_USER=nomoodoc
POSTGRES_PASSWORD=nomoodoc123
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8000

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Security
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=your-32-character-encryption-key

# AI Services
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Environment
ENVIRONMENT=development
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# External Services
TOSS_API_KEY=your-toss-api-key
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
MODUSIGN_API_KEY=your-modusign-api-key

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=nomoodoc-documents
AWS_REGION=ap-northeast-2

# Email
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@nomoodoc.com
